# Copy to .env, edit, then restart. Do not commit .env.
# disabled | ollama | vllm | cloud
ARCSYNC_LLM_PROVIDER=disabled
ARCSYNC_LLM_BASE_URL=http://127.0.0.1:11434
ARCSYNC_LLM_MODEL=
ARCSYNC_LLM_API_KEY=

# May use another service/model. A chat model is not usually an embedding model.
ARCSYNC_EMBEDDING_PROVIDER=ollama
ARCSYNC_EMBEDDING_BASE_URL=http://127.0.0.1:11434
ARCSYNC_EMBEDDING_MODEL=
ARCSYNC_EMBEDDING_API_KEY=

# Default: public, effective archives only in model contexts.
# Enabling restricted contexts also requires BOTH endpoints to be loopback,
# BOTH providers to be local (not cloud), AND the requesting role to be protector.
ARCSYNC_ALLOW_RESTRICTED_MODEL_CONTEXT=false

# Empty = keep existing SQLite database; MySQL 8.0.13+/8.4 LTS supported.
# URL-encode special characters in username/password.
ARCSYNC_DATABASE_URL=
# Example: mysql://arcsync:URL_ENCODED_PASSWORD@127.0.0.1:3307/arcsync
# ARCSYNC_DB=data/arcsync.sqlite3
# ARCSYNC_VECTOR_DIR=data/vectors

# Optional local MySQL container, only used by scripts/start_mysql.sh.
ARCSYNC_MYSQL_ROOT_PASSWORD=
ARCSYNC_MYSQL_PASSWORD=

# Optional HS256 signing key (32+ characters); otherwise generated in a private DB table.
ARCSYNC_JWT_SECRET=

# 聊天始终使用SQLite；未设置时按业务库模式选择默认文件。
# ARCSYNC_CHAT_DB=data/chat.sqlite3

# 可选：运维批准的评测模型档案。密钥只引用环境变量；浏览器不能提交模型地址。
# ARCSYNC_EVALUATION_PROFILES=/absolute/path/to/approved-evaluation-models.json
