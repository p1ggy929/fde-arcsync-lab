# 复制到项目根目录 .env.production；该文件已被Git忽略。不要填写真实密钥到本模板。
ARCSYNC_ENV=production
ARCSYNC_DOMAIN=archives.example.com
ARCSYNC_ALLOWED_HOSTS=archives.example.com
ARCSYNC_IMAGE=arcsync:phase1
ARCSYNC_JWT_SECRET=
ARCSYNC_REDIS_PASSWORD=
# Redis密码请使用URL安全随机字符串，地址中的密码须与上面一致。
ARCSYNC_REDIS_URL=redis://:REPLACE@redis:6379/0
ARCSYNC_DB=/state/business.sqlite3
ARCSYNC_CHAT_DB=/state/chat.sqlite3
ARCSYNC_GLOBAL_CONCURRENCY=4
ARCSYNC_HTTP_PER_MINUTE=120
ARCSYNC_LOGIN_PER_MINUTE=10
ARCSYNC_DAILY_TOKENS=1000000
ARCSYNC_USER_DAILY_TOKENS=100000
# 以下单位为百万分之一美元：10000000 = 10美元。
ARCSYNC_DAILY_MICRO_USD=10000000
ARCSYNC_USER_DAILY_MICRO_USD=1000000
ARCSYNC_USAGE_RETENTION_DAYS=90
# 必须按供应商及实际使用模型设置价格，不能照抄示例。免费本地模型可显式设0。
ARCSYNC_INPUT_USD_PER_MILLION=
ARCSYNC_OUTPUT_USD_PER_MILLION=
ARCSYNC_EMBEDDING_USD_PER_MILLION=
# 模型配置沿用项目.env.example；在此填写生产配置，未配置时问答返回明确错误。
# ARCSYNC_MYSQL_CA=/run/secrets/mysql-ca.pem
